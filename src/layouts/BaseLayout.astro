---
// src/layouts/BaseLayout.astro
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Agency Portfolio", 
  description = "Clean, modern, high-contrast." 
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<div class="site-wrapper">
			<nav class="main-nav">
				<a href="/" class="brand">INTER.</a>
				<div class="nav-links">
					<a href="/work">Work</a>
					<a href="/about">About</a>
				</div>
			</nav>

			<main>
				<slot />
			</main>

			<footer class="main-footer">
				<p>© 2026 — Built with Astro</p>
				<div class="status-indicator">Available for projects</div>
			</footer>
		</div>
	</body>
</html>

<style>

	.site-wrapper {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		padding: 0 2rem; 
	}

	.main-nav {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		padding: 2rem 0;
		border-bottom: 1px solid var(--black);
	}

	.brand {
		font-weight: 900;
		font-size: 1.5rem;
		letter-spacing: -0.05em;
	}

	.nav-links {
		display: flex;
		gap: 2rem;
		text-transform: uppercase;
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.1em;
	}

	main {
		flex: 1;
		padding: 4rem 0;
	}

	.main-footer {
		display: flex;
		justify-content: space-between;
		padding: 2rem 0;
		font-size: 0.75rem;
		border-top: 1px solid var(--black);
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	@media (max-width: 768px) {
		.site-wrapper {
			padding: 0 1rem;
		}
		
		.main-footer {
			flex-direction: column;
			gap: 1rem;
		}
	}
</style>
